{
	"compilerOptions": {
		"strict": true,
		"incremental": true,
		"target": "es2019",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"sourceMap": true,
		"esModuleInterop": true,
		"declaration": true,
		"declarationMap": true,
		"rootDir": "src",
		"outDir": "lib",
		"declarationDir": "./lib"
	},
	"include": [
		"src/**/*"
	],
	"ts-node": {
		"transpileOnly": true
	}
}
