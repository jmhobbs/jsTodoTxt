{
  "name": "@jstodotxt/cli",
  "version": "0.0.1",
  "description": "A simple CLI for todo.txt. Compatible with todo.sh",
  "keywords": [
    "todo.txt",
    "todo"
  ],
  "author": "John Hobbs <john@velvetcache.org>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmhobbs/jsTodoTxt.git",
    "directory": "cli"
  },
  "main": "./dist/main.js",
  "files": [
    "./dist",
    "!**/*.test.{js,d.ts}{,.map}"
  ],
  "bin": {
    "todo": "dist/main.js"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc",
    "lint": "run-s lint:*",
    "lint:eslint": "eslint . --ext .ts",
    "lint:format": "prettier --check 'src/**/*.ts'",
    "prepare": "run-s test lint clean build",
    "test": "c8 --reporter=lcov --reporter=text ava",
    "dev:test": "ava --watch",
    "todo": "tsx src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "ava": "^8.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-ava": "^17.0.1",
    "jstodotxt": "file:..",
    "prettier": "^2.7.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^9.4.1"
  },
  "ava": {
    "files": [
      "./src/**/*.test.ts"
    ],
    "extensions": [
      "ts"
    ],
    "nodeArguments": [
      "--import=tsx/esm"
    ]
  }
}
